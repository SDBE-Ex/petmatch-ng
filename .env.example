# Required Vercel environment variables (Project Settings > Environment Variables > Production)
# Set with: vercel env add <NAME> production
# Confirm what's currently set with: vercel env ls production

# Cloudflare Turnstile secret key (Cloudflare dashboard > Turnstile > your widget).
# Used server-side in api/pets/create.js to verify the token from the widget
# embedded in index.html. Never expose this one client-side.
TURNSTILE_SECRET_KEY=

# Supabase service-role key (Supabase dashboard > Project Settings > API, or
# `supabase projects api-keys --project-ref <ref>`). Used server-side in
# api/pets/create.js to insert anonymous listings, bypassing RLS by design.
# Full database access — never expose this one client-side either.
SUPABASE_SERVICE_ROLE_KEY=

# --- Also required, but NOT a Vercel env var ---
# SUPABASE_ACCESS_TOKEN — a GitHub Actions repo secret (Settings > Secrets and
# variables > Actions), used by .github/workflows/supabase-migrations.yml to
# push migrations on every push to main that touches supabase/migrations/**.
# Check it's set with: gh secret list

# --- Intentionally NOT env vars — hardcoded in source, safe to expose client-side ---
# SUPABASE_ANON_KEY   — index.html, admin.html, api/pets/[id].js, api/sitemap.js, api/updates/[id].js
# TURNSTILE_SITE_KEY  — index.html (public counterpart to TURNSTILE_SECRET_KEY above)
